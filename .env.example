# Supabase: Project Settings → API
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Monitorización de errores con Sentry (opcional). Vacío = apagada: no se
# descarga Sentry ni se envía nada. Solo actúa en el build de producción.
# Sentry: Settings → Projects → <proyecto> → Client Keys (DSN)
VITE_SENTRY_DSN=
